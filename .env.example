# Cortex Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env

# ── Required ─────────────────────────────────────────────────────────
# OpenRouter API key (get one at https://openrouter.ai/keys)
LLM_API_KEY=sk-or-...

# ── Optional ─────────────────────────────────────────────────────────
# LLM model to use for knowledge compilation
# COMPILER_MODEL=anthropic/claude-sonnet-4

# LLM API base URL (default: OpenRouter)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Path to your vault directory (default: ./example_vault)
# VAULT_DIR=./example_vault

# ── QMD Settings ──────────────────────────────────────────────────
# Embed timeout in milliseconds (default: 600000 = 10 min; increase for CPU-only)
# QMD_EMBED_TIMEOUT_MS=600000

# Search-result cache TTL in seconds (default: 30). Raise on read-heavy or
# slowly-changing vaults so repeated queries skip QMD entirely — biggest
# win for hybrid mode on CPU-only hosts. Cache also invalidates on writes.
# QMD_CACHE_TTL_SECONDS=300

# Default search mode when a request doesn't specify one (default: hybrid).
# Values: hybrid (BM25 + vector + re-rank, best quality), semantic, keyword (fastest).
# QMD_SEARCH_MODE=hybrid

# Per-request search timeout in seconds (default: 120). Increase for hybrid
# mode on CPU-only hosts where query expansion + embed + rerank can be slow.
# QMD_SEARCH_TIMEOUT_SECONDS=120

# For NVIDIA GPU acceleration on EC2/Linux, start with:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build -d

# ── Authentication ───────────────────────────────────────────────────
# AUTH_METHOD controls which authentication is enforced.
# Values: none (default), apikey, oidc
# AUTH_METHOD=none

# ── API Key Authentication (AUTH_METHOD=apikey) ──────────────────────
# Static API key for simple auth. Clients pass x-api-key header.
# API_KEY=your-secret-api-key

# ── OIDC Authentication (AUTH_METHOD=oidc) ───────────────────────────
# Microsoft Entra ID (Azure AD) settings.
# GET /api/v1/login starts the OAuth flow, all other API endpoints
# require Authorization: Bearer <token>, and MCP uses OIDCProxy.
# OIDC_TENANT_ID=your-tenant-id
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_BASE_URL=http://localhost:8420

# ── Microsoft Teams (feedback notifications) ───────────────────────────
# Incoming Webhook or Power Automate workflow URL for the target channel.
# When set, POST /api/v1/feedbacks and vault_feedback MCP tool post a card
# after each new feedback note. Leave empty to disable.
# TEAMS_WEBHOOK_URL=https://<your-power-automate-or-incoming-webhook-url>?sig=<your-signature>
# Optional public Cortex base URL for a "View in Cortex" link on the card.
# TEAMS_APP_BASE_URL=https://cortex.example.com
