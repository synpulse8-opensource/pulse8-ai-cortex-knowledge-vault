# Cortex Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env

# ── Required ─────────────────────────────────────────────────────────
# OpenRouter API key (get one at https://openrouter.ai/keys)
LLM_API_KEY=sk-or-...

# ── Optional ─────────────────────────────────────────────────────────
# LLM model to use for knowledge compilation
# COMPILER_MODEL=anthropic/claude-sonnet-4

# LLM API base URL (default: OpenRouter)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Path to your vault directory (default: ./example_vault)
# VAULT_DIR=./example_vault

# ── OIDC Authentication (optional) ──────────────────────────────────
# Microsoft Entra ID (Azure AD) settings. Set all four to enable auth.
# When set, POST /api/v1/login returns access tokens, all other API
# endpoints require Authorization: Bearer <token>, and MCP uses OIDCProxy.
# OIDC_TENANT_ID=your-tenant-id
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_BASE_URL=http://localhost:8420

# ── API Key Authentication (optional) ───────────────────────────────
# Static API key for simple auth. Clients pass x-api-key header.
# Bypasses OIDC when set. Useful for service-to-service calls.
# API_KEY=your-secret-api-key
