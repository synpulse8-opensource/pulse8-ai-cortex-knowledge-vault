# Cortex Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env

# ── Required ─────────────────────────────────────────────────────────
# OpenRouter API key (get one at https://openrouter.ai/keys)
LLM_API_KEY=sk-or-...

# ── Optional ─────────────────────────────────────────────────────────
# LLM model to use for knowledge compilation
# COMPILER_MODEL=anthropic/claude-sonnet-4

# LLM API base URL (default: OpenRouter)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Path to your vault directory (default: ./example_vault)
# VAULT_DIR=./example_vault

# ── Content Masking ─────────────────────────────────────────────────
# Enable content masking during ingestion (default: false)
# MASKING_ENABLED=true

# Path to masking rules file, relative to vault root (default: .cortex/masking-rules.md)
# MASKING_RULES_PATH=.cortex/masking-rules.md

# LLM model for context-aware masking (default: uses COMPILER_MODEL)
# MASKING_MODEL=
