FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04

ARG QMD_COMMIT=6366024

# RUN apt-get update \
#     && apt-get install -y --no-install-recommends \
#        tini wget ca-certificates curl \
#     && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
#     && apt-get install -y --no-install-recommends nodejs \
#     && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       tini wget ca-certificates curl gnupg xz-utils \
       python3 make g++ build-essential \
    && curl -fsSL https://nodejs.org/dist/v22.11.0/node-v22.11.0-linux-x64.tar.xz -o node.tar.xz \
    && tar -xf node.tar.xz -C /usr/local --strip-components=1 \
    && rm node.tar.xz \
    && node -v \
    && npm -v

# Pin QMD to a git commit; switch to `npm install -g @tobilu/qmd` once released.
WORKDIR /opt/qmd-src
RUN wget -qO- "https://github.com/tobi/qmd/archive/${QMD_COMMIT}.tar.gz" | tar xz --strip-components=1 \
    && npm install \
    && npm install typescript@^5.9.3 \
    && npm run build \
    && npm install -g . \
    && cd / \
    && rm -rf /opt/qmd-src
WORKDIR /

RUN groupadd -r qmd && useradd -r -g qmd -m -d /home/qmd qmd

RUN mkdir -p /vault /home/qmd/.cache/qmd/models \
    && chown -R qmd:qmd /home/qmd/.cache

COPY --chown=qmd:qmd server.mjs /opt/qmd/server.mjs
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER qmd

ENV VAULT_PATH=/vault
ENV QMD_PORT=3100
ENV NODE_ENV=production
ENV XDG_CONFIG_HOME=/home/qmd/.cache

EXPOSE 3100

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD node -e "fetch('http://localhost:3100/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

ENTRYPOINT ["tini", "--", "entrypoint.sh"]
CMD ["node", "/opt/qmd/server.mjs"]
